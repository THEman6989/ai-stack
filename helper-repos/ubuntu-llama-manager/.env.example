# Copy this file to ubuntu-llama.conf or .env for local use.
# Do not commit real tokens or machine-specific secrets.

RUN_AS_USER="amin"
RUN_AS_GROUP="amin"

# Llama service
ENABLE_LLAMA_SERVICE="true"
START_LLAMA_ON_BOOT="true"
LLAMA_WORKDIR="/home/amin/experi/llama.cpp"
LLAMA_COMMAND="./build/bin/llama-server -hf unsloth/Qwen3.6-35B-A3B-GGUF:Q8_0 --jinja --host 0.0.0.0 --port 8033 -ngl 999 -c 128000 -np 1 -fa on -sm layer -b 512 -ub 256 --cache-type-k q8_0 --cache-type-v q8_0 --no-mmap --repeat-penalty 1.05"
LLAMA_HOST="127.0.0.1"
LLAMA_PORT="8033"
LLAMA_PROCESS_PATTERN="llama-server"
LLAMA_LOG_FILE="/home/amin/llama.log"
WATCH_EXTERNAL_LLAMA_PROCESS="true"
LLAMA_PORT_BUSY_WAIT_SECONDS="30"

# Optional shell initialization for ROCm/HIP paths if systemd starts too early
# or misses variables that exist in your interactive shell.
LLAMA_ENV_FILE=""
LLAMA_PRE_START_SLEEP_SECONDS="5"

# Optional second llama.cpp server. This keeps the main server unchanged and
# starts a separate systemd service: ubuntu-llama-8001.service.
ENABLE_LLAMA_SECONDARY_SERVICE="false"
START_LLAMA_SECONDARY_ON_BOOT="true"
LLAMA_SECONDARY_WORKDIR="/home/amin/experi/llama.cpp"
LLAMA_SECONDARY_COMMAND="./build/bin/llama-server -hf unsloth/Qwen3.5-2B-GGUF:Q4_1 --host 0.0.0.0 --port 8001 --no-mmproj -ngl 99 -c 8192 -b 1024 -ub 1024 -ctk q8_0 -ctv q8_0 -fa on --reasoning off --chat-template-kwargs '{\"enable_thinking\":false}'"
LLAMA_SECONDARY_HOST="127.0.0.1"
LLAMA_SECONDARY_PORT="8001"
LLAMA_SECONDARY_PROCESS_PATTERN="llama-server.*--port 8001"
LLAMA_SECONDARY_LOG_FILE="/home/amin/llama-8001.log"
LLAMA_SECONDARY_PORT_BUSY_WAIT_SECONDS="30"
LLAMA_SECONDARY_ENV_FILE=""
LLAMA_SECONDARY_PRE_START_SLEEP_SECONDS="15"

# API for the future AI stack
ENABLE_API_SERVICE="true"
# 0.0.0.0 makes the API reachable from other machines on the network.
# Keep API_TOKEN strong because dangerous endpoints use Bearer auth.
API_HOST="0.0.0.0"
API_PORT="8099"
API_TOKEN="change-me"
# Optional UFW source for ./install.sh firewall-allow.
# Empty means allow API_PORT from everywhere. Example: 192.168.178.0/24
API_FIREWALL_ALLOW_FROM=""

# AI-Stack recovery probe. The manager sends a tiny non-streaming generation
# request before deciding whether Llama is hung or actually still responds.
LLAMA_PROBE_BASE_URL=""
LLAMA_PROBE_PATH="/completion"
LLAMA_PROBE_PROMPT="Reply with exactly: ok"
LLAMA_PROBE_MAX_TOKENS="8"
LLAMA_PROBE_TIMEOUT_SECONDS="20"
LLAMA_PROBE_REQUIRE_CONTENT="true"

# Auto reboot. This is an intended stability feature.
ENABLE_AUTO_REBOOT="true"
REBOOT_INTERVAL_HOURS="3"
REBOOT_BACKEND="timer"
REBOOT_TIMER_MODE="boot"
REBOOT_COMMAND="/usr/bin/systemctl reboot"
REBOOT_GRACE_SECONDS="10"
STOP_LLAMA_BEFORE_REBOOT="false"
REBOOT_USE_ESP_POWER_CYCLE="false"
REBOOT_REQUIRE_ESP_WEBHOOK="true"
REBOOT_LOCAL_SHUTDOWN_AFTER_ESP="true"
REBOOT_ESP_SHUTDOWN_COMMAND="/usr/bin/systemctl poweroff"
ESP_POWER_ACTION_ON_REBOOT="power-on"
GPU_FAULT_LOCAL_SHUTDOWN_AFTER_ESP="true"
GPU_FAULT_SHUTDOWN_COMMAND="/usr/bin/systemctl poweroff"

# Legacy compatibility. Used only when REBOOT_INTERVAL_SECONDS and
# REBOOT_INTERVAL_HOURS are empty.
REBOOT_INTERVAL_SECONDS=""
REBOOT_AFTER_SECONDS=""

# GPU power limit for AMD Instinct MI50/MI60 cards.
ENABLE_GPU_POWER_LIMIT="false"
GPU_POWER_TOOL="rocm-smi"
POWER_LIMIT_GPU_IDS="all"
POWER_LIMIT_WATTS="160"
RESET_POWER_LIMIT_ON_DISABLE="false"

# Optional GPU clock/performance tuning through rocm-smi.
# Empty values are skipped. Clock levels require GPU_PERF_LEVEL="manual".
# To keep clocks automatic while preserving the power cap, leave
# ENABLE_GPU_CLOCK_TUNING=false and RESET_CLOCKS_ON_DISABLE=true.
ENABLE_GPU_CLOCK_TUNING="false"
GPU_PERF_LEVEL="auto"
GPU_SCLK_LEVELS=""
GPU_MCLK_LEVELS=""
GPU_PCIE_LEVELS=""
RESET_CLOCKS_ON_DISABLE="true"

# GPU health monitor. Runs best as a root systemd service, so it does not need
# a sudo password in config.
ENABLE_GPU_HEALTH_MONITOR="true"
GPU_HEALTH_POLL_SECONDS="10"
GPU_HEALTH_CRITICAL_ACTION="shutdown"
GPU_HEALTH_CRITICAL_PATTERNS="GPU reset|amdgpu.*ring.*timeout|amdgpu.*GPU fault|RAS.*uncorrectable|ENABLED\\s+[0-9]+\\s+[1-9][0-9]*|PCIe.*AER|AER:.*error|pcieport.*error|GPU has fallen off|not responding"
GPU_HEALTH_DMESG_SINCE_SECONDS="300"
GPU_HEALTH_MIN_VRAM_FREE_MB="512"
GPU_HEALTH_PCIE_REPLAY_THRESHOLD="0"

# Optional ESP direct webhook for hard power control preparation.
ESP_WEBHOOK_URL=""
ESP_WEBHOOK_TOKEN=""
ESP_ACTION_TIMEOUT_SECONDS="5"
ESP_POWER_HOLD_SECONDS="8"
ESP_POWER_WAIT_SECONDS="20"
ESP_POWER_DELAY_BEFORE_ACTION_SECONDS="20"
ESP_NOTIFY_SETTLE_SECONDS="2"
ESP_POWER_ACTION_ON_GPU_FAULT="power-cycle"
GPU_FAULT_REQUIRE_ESP_WEBHOOK="true"
GPU_FAULT_ESP_RETRIES="3"
GPU_FAULT_ESP_RETRY_SECONDS="2"

# HuggingFace/local model scan
HF_CACHE_DIR="/home/amin/.cache/huggingface"
MODEL_SCAN_DIRS="/home/amin/.cache/huggingface:/home/amin/experi/llama.cpp"
MODEL_SCAN_MAX_FILES="20000"

# ESP8266 / NodeMCU preparation
ENABLE_ESP_API="true"
ESP_HEARTBEAT_AUTH_REQUIRED="false"
ESP_STALE_AFTER_SECONDS="90"

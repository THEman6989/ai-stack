# Copy this file to .env and edit .env locally.
# Do not commit .env. It contains WiFi passwords and API tokens.
#
# Quick start:
#   cp .env.example .env
#   nano .env
#   ./generate-config.sh

# WLAN HIER EINTRAGEN. Put your real SSID/password only in .env.
WIFI_SSID="DEIN_WLAN_NAME"
WIFI_PASSWORD="DEIN_WLAN_PASSWORT"

# Ubuntu Llama Manager URL. Use the Ubuntu server LAN IP, not localhost.
MANAGER_BASE_URL="http://192.168.178.153:8099"

# Test token. Change later when the ESP flow works.
MANAGER_API_TOKEN="1234"

# Test token for incoming manager -> ESP requests. Change later.
ESP_AUTH_TOKEN="1234"

# Manager-only ESP target. Fill this after the ESP prints its WiFi IP.
# The firmware ignores this value, but Ubuntu Llama Manager reads the same .env.
ESP_WEBHOOK_URL="http://192.168.178.80/action"

# Manager-only reboot policy. The firmware ignores these values, but Ubuntu
# Llama Manager reads the same .env so you do not need to duplicate them.
#
# Normal auto-reboot:
#   1. Manager tells ESP to press power-on later.
#   2. Manager runs normal systemctl poweroff.
#   3. ESP presses the power button after the delay.
ENABLE_AUTO_REBOOT="false"
REBOOT_USE_ESP_POWER_CYCLE="true"
REBOOT_REQUIRE_ESP_WEBHOOK="true"
REBOOT_LOCAL_SHUTDOWN_AFTER_ESP="true"
REBOOT_ESP_SHUTDOWN_COMMAND="/usr/bin/systemctl poweroff"
ESP_POWER_ACTION_ON_REBOOT="power-on"

# GPU/kernel fault:
#   1. Manager tells ESP to do a hard power-cycle after the delay.
#   2. Manager still tries normal systemctl poweroff first.
#   3. If Ubuntu gets stuck, ESP cuts/presses power via optocoupler.
GPU_FAULT_LOCAL_SHUTDOWN_AFTER_ESP="true"
GPU_FAULT_SHUTDOWN_COMMAND="/usr/bin/systemctl poweroff"
ESP_POWER_ACTION_ON_GPU_FAULT="power-cycle"
ESP_POWER_HOLD_SECONDS="8"
ESP_POWER_WAIT_SECONDS="20"
ESP_POWER_DELAY_BEFORE_ACTION_SECONDS="20"
ESP_NOTIFY_SETTLE_SECONDS="2"
GPU_FAULT_REQUIRE_ESP_WEBHOOK="true"
GPU_FAULT_ESP_RETRIES="3"
GPU_FAULT_ESP_RETRY_SECONDS="2"

ESP_DEVICE_ID="nodemcu-v3-main"

# Optocoupler pins. D1/GPIO5 and D2/GPIO4 are safer than boot strap pins.
POWER_BUTTON_PIN="D1"
RESET_BUTTON_PIN="D2"
STATUS_LED_PIN="LED_BUILTIN"
OUTPUT_ACTIVE_HIGH="true"

# Safer for PC817/Optokoppler modules: leave D1/D2 high impedance while idle.
# The pin is driven only during an actual power/reset press.
GPIO_IDLE_FLOAT="true"

# Default action timings. The manager can override these per request.
DEFAULT_SHORT_PRESS_SECONDS="1"
DEFAULT_FORCE_OFF_HOLD_SECONDS="8"
DEFAULT_WAIT_AFTER_OFF_SECONDS="20"
DEFAULT_DELAY_BEFORE_ACTION_SECONDS="30"
HEARTBEAT_INTERVAL_SECONDS="30"

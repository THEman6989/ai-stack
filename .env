ALPHARAVIS_RUN_STATE_MANAGER_ENABLED=true
ALPHARAVIS_RUN_STATE_AUTO_RESUME=false
ALPHARAVIS_RUN_STATE_RESUME_PROMPT_TIMEOUT_SECONDS=300
ALPHARAVIS_RUN_STATE_DB=alpharavis_state
ALPHARAVIS_RUN_STATE_COLLECTION=run_checkpoints
ALPHARAVIS_ASYNC_REVIEWER_ENABLED=false
ALPHARAVIS_ASYNC_REVIEWER_MODEL=
ALPHARAVIS_ASYNC_REVIEWER_TIMEOUT_SECONDS=45
ALPHARAVIS_ASYNC_REVIEWER_MAX_TOKENS=512
ALPHARAVIS_ASYNC_REVIEWER_TEMPERATURE=0
ALPHARAVIS_ASYNC_REVIEWER_MIN_OUTPUT_CHARS=120
ALPHARAVIS_ASYNC_REVIEW_STORE_PATH=/tmp/alpharavis_run_reviews.json
ALPHARAVIS_RUNTIME_SETTINGS_FILE=/workspace/service-dashboard-data/runtime_settings.json
ALPHARAVIS_ENABLE_SERVER_MODEL_MANAGER=true
ALPHARAVIS_CRISIS_MAX_WALL_CLOCK_SECONDS=180
ALPHARAVIS_CRISIS_ACTION_TIMEOUT_SECONDS=90
ALPHARAVIS_SERVER_MODEL_MANAGER_MODEL=openai/server-model-manager
ALPHARAVIS_SERVER_MODEL_MANAGER_FALLBACK_MODEL=openai/edge-gemma
ALPHARAVIS_SERVER_MODEL_MANAGER_TIMEOUT_SECONDS=90
ALPHARAVIS_SERVER_MODEL_MANAGER_FALLBACK_TIMEOUT_SECONDS=60
ALPHARAVIS_SERVER_MODEL_MANAGER_TEMPERATURE=0
ALPHARAVIS_UBUNTU_LLAMA_ESP_IP=192.168.178.113
ALPHARAVIS_UBUNTU_LLAMA_ESP_PORT=80
ALPHARAVIS_UBUNTU_LLAMA_ESP_URL=
ALPHARAVIS_UBUNTU_LLAMA_ESP_API_KEY=1234
ALPHARAVIS_UBUNTU_LLAMA_CONTEXT_MIN=512
ALPHARAVIS_UBUNTU_LLAMA_CONTEXT_MAX=262144
ALPHARAVIS_UBUNTU_LLAMA_PARALLEL_MAX=2
ALPHARAVIS_CONTEXT_SCHEDULER_ENABLED=auto
ALPHARAVIS_CONTEXT_SAFETY_FACTOR=0.92
ALPHARAVIS_CONTEXT_DEFAULT_MAX_OUTPUT_TOKENS=2048
ALPHARAVIS_CONTEXT_LEASE_SAFETY_MARGIN_TOKENS=1024
ALPHARAVIS_LLAMA_RUNTIME_TIMEOUT_SECONDS=30
ALPHARAVIS_BACKGROUND_TASKS_ENABLED=true
ALPHARAVIS_BACKGROUND_READ_ONLY_MAX_CONCURRENCY=4
ALPHARAVIS_BACKGROUND_SMALL_LLM_MAX_CONCURRENCY=2
ALPHARAVIS_BACKGROUND_CONTEXT_MAX_UTILIZATION=0.70
ALPHARAVIS_BACKGROUND_TASK_TIMEOUT_SECONDS=30
ALPHARAVIS_BACKGROUND_CANCEL_ON_CONTEXT_PRESSURE=true
ALPHARAVIS_LLAMA_RUNTIME_HOST_OVERRIDE=
ALPHARAVIS_SECONDARY_CONTEXT_NORMAL=8192
ALPHARAVIS_SECONDARY_CONTEXT_HIGH=16384
ALPHARAVIS_PRIMARY_CONTEXT_NORMAL=131072
ALPHARAVIS_PRIMARY_CONTEXT_HIGH=200000
SERVER_MODEL_MANAGER_MODEL_NAME=server-model-manager
ALPHARAVIS_CURATED_MEMORY_REVIEW_PATH=/tmp/alpharavis_curated_memory_review.json
ALPHARAVIS_CURATED_MEMORY_AUTO_ACCEPT_THRESHOLD=

# ── Storage Manager ──
# Feature flag (default OFF). Set to true to enable per-service disk quotas.
ALPHARAVIS_STORAGE_MANAGER_ENABLED=true
# Total cap in GB across all data services. Default 50.
ALPHARAVIS_STORAGE_MAX_TOTAL_GB=50
# Warn when a service exceeds this percentage of its budget. Default 90.
ALPHARAVIS_STORAGE_WARN_THRESHOLD_PCT=90
# Dry-run mode: only report, never delete. Default false.
ALPHARAVIS_STORAGE_DRY_RUN=false
# Per-service percentage allocations (must sum to ~100):
# ALPHARAVIS_STORAGE_LIBRECHAT_PCT=15
# ALPHARAVIS_STORAGE_MEDIA_GALLERY_PCT=40
# ALPHARAVIS_STORAGE_HERMES_PCT=5
# ALPHARAVIS_STORAGE_PIXELLE_PCT=10
# ALPHARAVIS_STORAGE_OPENWEBUI_PCT=15
# ALPHARAVIS_STORAGE_LOGS_PCT=5
# ALPHARAVIS_STORAGE_OTHER_PCT=10

# ComfyUI local runtime smoke: Unix-socket relay bypasses Docker->host firewall blocks.
ALPHARAVIS_COMFYUI_PUBLIC_BASE_URL=http://localhost:8188
ALPHARAVIS_ENABLE_COMFYUI_AGENT=true
NEXT_PUBLIC_COMFYUI_AGENT_ENABLED=true
NEXT_PUBLIC_COMFYUI_AGENT_NAME=comfyui_agent
ALPHARAVIS_ENABLE_COMFYUI_WORKFLOW_LIBRARY=true
ALPHARAVIS_ENABLE_COMFYUI_WORKFLOW_SUBMIT=true

# LLM-powered background review: after every agent turn, a dedicated curation
# LLM pass analyzes the conversation and extracts structured, curated
# memories and skill candidates — the LLM IS the curator (no regex).
# Default false. Set true to enable Hermes-style background review.
